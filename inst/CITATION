year <- if (!is.null(meta$`Date/Publication`)) {
  substr(meta$`Date/Publication`, 1L, 4L)
} else if (!is.null(meta$Date)) {
  substr(meta$Date, 1L, 4L)
} else {
  format(Sys.Date(), "%Y")
}

bibentry(
  bibtype  = "Manual",
  title    = sprintf("{anovakit}: %s", meta$Title),
  author   = person("Justin", "Chase"),
  year     = year,
  note     = sprintf("R package version %s", meta$Version),
  url      = "https://github.com/elkronos/anovakit"
)
