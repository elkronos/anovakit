# As a MANCOVA: the marginal means are adjusted for age, and the
# common-slope assumption is tested
mc <- anova_manova(d, c("score1", "score2"), "g",
                   covariates = "age", plots = FALSE)
mc$emmeans
mc$slopes_test

}
